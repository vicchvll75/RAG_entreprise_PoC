# Fournisseur LLM : "mistral" ou "openai" (les deux via l'API compatible OpenAI)
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
OPENAI_API_KEY=

# Modèles (laisser vide = valeurs par défaut du fournisseur)
GENERATION_MODEL=
JUDGE_MODEL=
EMBEDDING_MODEL=

# "api" (mistral-embed / text-embedding-3-small) ou "local" (ONNX MiniLM, sans clé)
EMBEDDING_BACKEND=api

TOP_K=5
# Garde-fou anti-hallucination en ligne : bloque la réponse si la fidélité Ragas < seuil
FAITHFULNESS_GUARDRAIL=false
FAITHFULNESS_THRESHOLD=0.7
